@article{zhang_2013,
	title = {Mixed‐integer linear model for transmission expansion planning with line losses and energy storage systems},
	volume = {7},
	issn = {1751-8687, 1751-8695},
	doi = {10.1049/iet-gtd.2012.0666},
	abstract = {In this study, a deterministic single‐stage transmission expansion planning model considering line losses and deployment of energy storage systems (ESSs) is proposed. A piecewise linearisation approach using secant segments is adopted to estimate non‐linear line losses, and the optimal partitioning method is studied. ESSs are introduced to reduce the overall cost, and their siting and sizing are determined by nodal power balance and load duration curve. The effectiveness of the proposed model is shown through case studies simulated on two test systems, and the potential of ESSs reducing network investment costs is illustrated in a quantitative manner.},
	language = {en},
	number = {8},
	journal = {IET Generation, Transmission \& Distribution},
	author = {Zhang, Fang and Hu, Zechun and Song, Yonghua},
	month = aug,
	year = {2013},
	pages = {919--928}
}

