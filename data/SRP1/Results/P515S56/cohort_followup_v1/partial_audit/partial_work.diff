+                synced[(node_id, year)] = {'gross_flow': gross_flow, 's': abs(total['s']), 'e': abs(total['e'])}
+        setattr(network, SHARED_ESS_COHORT_GROSS_FLOW_DATA_ATTRIBUTE, synced)
