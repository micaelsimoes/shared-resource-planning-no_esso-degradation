 "A_provenance": {
  "phase": "pre",
  "git_head": "441244e39dd22926ed66cebc13225088b4254803",
  "timestamp_utc": "2026-09-06T14:12:35.088178+00:00",
  "ess_pnet_rule_source": "def ess_pnet_rule(m, e, s_m, s_o, p):\n    return m.es_pnet[e,s_m,s_o,p] == m.es_pdch[e,s_m,s_o,p] - m.es_pch[e,s_m,s_o,p]\n",
  "ess_snet_def_rule_source": "def ess_snet_def_rule(m, e, s_m, s_o, p):\n    snet = m.es_sch[e, s_m, s_o, p] - m.es_sdch[e, s_m, s_o, p]\n    return snet ** 2 == m.es_pnet[e, s_m, s_o, p] ** 2 + m.es_qnet[e, s_m, s_o, p] ** 2\n",
  "ess_phi_limits_lower_source": "def ess_phi_limits_lower(m, e, s_m, s_o, p, network):\n    ess = network.energy_storages[e]\n    tangent_lower, tangent_upper = _power_factor_tangents(ess)\n    pch = m.es_pch[e, s_m, s_o, p]\n    pdch = m.es_pdch[e, s_m, s_o, p]\n    return m.es_qnet[e, s_m, s_o, p] >= tangent_lower * pdch - tangent_upper * pch\n",
  "ess_phi_limits_upper_source": "def ess_phi_limits_upper(m, e, s_m, s_o, p, network):\n    ess = network.energy_storages[e]\n    tangent_lower, tangent_upper = _power_factor_tangents(ess)\n    pch = m.es_pch[e, s_m, s_o, p]\n    pdch = m.es_pdch[e, s_m, s_o, p]\n    return m.es_qnet[e, s_m, s_o, p] <= tangent_upper * pdch - tangent_lower * pch\n",
  "ess_comp_rule_source": "def ess_comp_rule(m, e, s_m, s_o, p, network, params):\n    sch = m.es_sch[e, s_m, s_o, p]\n    sdch = m.es_sdch[e, s_m, s_o, p]\n    s_rated = network.energy_storages[e].s\n    if params.ess_model == ESS_MODEL_EXACT:\n        return sch * sdch <= EQUALITY_TOLERANCE\n    elif params.ess_model == ESS_MODEL_BILINEAR_RELAXATION:\n        return sch * sdch <= ESS_COMPLEMENTARITY_TOLERANCE * s_rated ** 2\n    elif params.ess_model == ESS_MODEL_POLYNOMIAL_COMPLEMENTARITY:\n        return sch ** 2 + sdch ** 2 <= (sch + sdch) ** 2 + EQUALITY_TOLERANCE\n    else:\n        return pe.Constraint.Skip\n",
  "ess_soc_rule_source": "def ess_soc_rule(m, e, s_m, s_o, p, network, params):\n\n    ess = network.energy_storages[e]\n    eff_ch = ess.eff_ch\n    eff_dch = ess.eff_dch\n    if p == 0:\n        soc_prev = ess.e_init\n    else:\n        soc_prev = m.es_soc[e, s_m, s_o, p-1]\n\n    delta = eff_ch * m.es_sch[e, s_m, s_o, p] - (m.es_sdch[e, s_m, s_o, p] / eff_dch)\n\n    return m.es_soc[e, s_m, s_o, p] == soc_prev + delta\n",
  "compute_node_load_ess_lines": [
   "                Pd -= model.es_pnet[e, s_m, s_o, p]",
   "                Qd -= model.es_qnet[e, s_m, s_o, p]",
   "            Pd += model.shared_es_pnet[e, s_m, s_o, p]",
   "            Qd += model.shared_es_qnet[e, s_m, s_o, p]"
  ],
  "process_results_ess_pq_lines": [
   "p_ess = pe.value(model.es_pch[e, s_m, s_o, p] - model.es_pdch[e, s_m, s_o, p]) * network.baseMVA",
   "q_ess = -pe.value(model.es_qnet[e, s_m, s_o, p]) * network.baseMVA",
   "processed_results['scenarios'][s_m][s_o]['energy_storages']['p'][es_id].append(p_ess)",
   "processed_results['scenarios'][s_m][s_o]['energy_storages']['q'][es_id].append(q_ess)"
  ]
