 "A_provenance": {
  "phase": "a",
  "git_head": "606aab719851041d295bca4d0a738041b95298bb",
  "timestamp_utc": "2026-09-06T14:41:31.672111+00:00",
  "ess_snet_def_rule_source": "def ess_snet_def_rule(m, e, s_m, s_o, p):\n    snet = m.es_sch[e, s_m, s_o, p] - m.es_sdch[e, s_m, s_o, p]\n    return snet ** 2 == m.es_pnet[e, s_m, s_o, p] ** 2 + m.es_qnet[e, s_m, s_o, p] ** 2\n",
  "ess_pnet_rule_source": "def ess_pnet_rule(m, e, s_m, s_o, p):\n    # Canonical ordinary-ESS convention (P4.6-B1): the ordinary ESS is\n    # represented as a LOAD, so positive net power is consumption from the\n    # network (charging) and negative net power is injection (discharging).\n    return m.es_pnet[e,s_m,s_o,p] == m.es_pch[e,s_m,s_o,p] - m.es_pdch[e,s_m,s_o,p]\n",
  "ess_comp_rule_source": "def ess_comp_rule(m, e, s_m, s_o, p, network, params):\n    sch = m.es_sch[e, s_m, s_o, p]\n    sdch = m.es_sdch[e, s_m, s_o, p]\n    s_rated = network.energy_storages[e].s\n    if params.ess_model == ESS_MODEL_EXACT:\n        return sch * sdch <= EQUALITY_TOLERANCE\n    elif params.ess_model == ESS_MODEL_BILINEAR_RELAXATION:\n        return sch * sdch <= ESS_COMPLEMENTARITY_TOLERANCE * s_rated ** 2\n    elif params.ess_model == ESS_MODEL_POLYNOMIAL_COMPLEMENTARITY:\n        return sch ** 2 + sdch ** 2 <= (sch + sdch) ** 2 + EQUALITY_TOLERANCE\n    else:\n        return pe.Constraint.Skip\n",
  "ess_soc_rule_source": "def ess_soc_rule(m, e, s_m, s_o, p, network, params):\n\n    ess = network.energy_storages[e]\n    eff_ch = ess.eff_ch\n    eff_dch = ess.eff_dch\n    if p == 0:\n        soc_prev = ess.e_init\n    else:\n        soc_prev = m.es_soc[e, s_m, s_o, p-1]\n\n    delta = eff_ch * m.es_sch[e, s_m, s_o, p] - (m.es_sdch[e, s_m, s_o, p] / eff_dch)\n\n    return m.es_soc[e, s_m, s_o, p] == soc_prev + delta\n",
  "ess_s_limit_rule_source": "def ess_s_limit_rule(m, e, s_m, s_o, p, network):\n    ess = network.energy_storages[e]\n    return m.es_sch[e, s_m, s_o, p] + m.es_sdch[e, s_m, s_o, p] <= ess.s + EQUALITY_TOLERANCE\n",
  "ordinary_scale_helper_present": false,
